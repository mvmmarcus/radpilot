# Copy to .env.local and fill in. Never commit real keys.
# `npm run db:start` (supabase start) prints the local URL and keys.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable key (sb_publishable_...) or the legacy anon key both work here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by scripts (dicom:upload) and admin tasks. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
# mock | openai | anthropic. "mock" is deterministic and needs no key (default).
AI_PROVIDER=mock
# Optional model override, e.g. gpt-4.1-mini or claude-sonnet-4-5
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
